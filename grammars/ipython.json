{
  "name": "IPython",
  "scopeName": "source.python.ipy",
  "type": "tree-sitter",
  "parser": "tree-sitter-ipython",
  "injectionNames": ["ipython", "ipy"],
  "firstLineRegex": [
    "^#![ \\t]*/.*\\bipython[\\d\\.]*\\b",
    "vim\\b.*\\bset\\b.*\\b(filetype|ft|syntax)=ipython"
  ],
  "fileTypes": ["ipy"],
  "comments": {
    "start": "# "
  },
  "treeSitter": {
    "parserSource": "github:lumine-code/tree-sitter-ipython#163acc8da4c9cfae3b6ee7be9d66b75d62dfc933",
    "wasmBuildTool": "tree-sitter-cli#v0.27.0",
    "grammar": "ipython.wasm",
    "highlightsQuery": ["python-highlights.scm", "ipython-highlights.scm"],
    "tagsQuery": "ipython-tags.scm",
    "foldsQuery": "ipython-folds.scm",
    "indentsQuery": "ipython-indents.scm"
  }
}
