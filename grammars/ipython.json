{
  "name": "IPython",
  "scopeName": "source.python.ipy",
  "type": "tree-sitter",
  "parser": "tree-sitter-ipython",
  "injectionNames": ["ipython", "ipy"],
  "firstLineRegex": [
    "^#![ \\t]*/.*\\bipython[\\d\\.]*\\b",
    // Stop at the first Vim and set tokens instead of backtracking over them.
    // \x0a keeps existing shebang prefix line counts unchanged.
    "(?:^|\\x0a)(?:(?!vim\\b).)*vim\\b(?:(?!\\bset\\b).)*\\bset\\b.*\\b(filetype|ft|syntax)=ipython"
  ],
  "fileTypes": ["ipy"],
  "comments": {
    "start": "# "
  },
  "treeSitter": {
    "parserSource": "github:lumine-code/tree-sitter-ipython#e91db2279869ddbdd9acdd9813487e042cd3dba0",
    "wasmBuildTool": "tree-sitter-cli#v0.27.0",
    "grammar": "ipython.wasm",
    "parseBoundariesQuery": "ipython-parse-boundaries.scm",
    "highlightsQuery": "ipython-highlights.scm",
    "tagsQuery": "ipython-tags.scm",
    "foldsQuery": "ipython-folds.scm",
    "indentsQuery": "ipython-indents.scm",
    "injectionsQuery": "ipython-injections.scm"
  }
}
